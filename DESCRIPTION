Package: dynasimR
Type: Package
Title: Dynamic Agent-Node Simulation Analysis
Version: 0.2.0
Authors@R: c(
    person(
      given   = "R.",
      family  = "Heller",
      role    = c("aut", "cre", "cph"),
      email   = "raban.heller@uni-ulm.de",
      comment = c(ORCID = "0000-0001-8006-9742")
